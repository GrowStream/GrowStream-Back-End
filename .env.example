# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=glow_stream

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage
UPLOAD_DIR=uploads
VIDEO_DIR=uploads/videos
THUMBNAIL_DIR=uploads/thumbnails
AVATAR_DIR=uploads/avatars
CHANNEL_DIR=uploads/channels

# FFmpeg (Video Processing)
# On Windows e.g.: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=

# HLS Settings
HLS_OUTPUT_DIR=uploads/hls
HLS_SEGMENT_DURATION=10
HLS_PLAYLIST_SIZE=6

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (Optional — for password reset emails)
# If left blank, reset tokens are printed to the backend console log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@glostream.com

# Elasticsearch (Optional - for search)
ELASTICSEARCH_NODE=http://localhost:9200

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud Storage (Optional - for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=glow-stream-videos
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
CLOUDFLARE_BUCKET_NAME=
